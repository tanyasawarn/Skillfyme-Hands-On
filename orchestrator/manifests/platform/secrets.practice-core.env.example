# Copy to secrets.practice-core.env (gitignored), fill in, then:
#   kubectl -n practiceengine-platform create secret generic practice-core-config \
#     --from-env-file=secrets.practice-core.env --dry-run=client -o yaml | kubectl apply -f -
DATABASE_URL=postgres://practice:CHANGEME@postgres.practiceengine-platform.svc:5432/practice_engine
REDIS_URL=redis://redis.practiceengine-platform.svc:6379
NATS_URL=nats://nats.practiceengine-platform.svc:4222
# MUST match orchestrator-config's ORCHESTRATOR_SHARED_SECRET.
ORCHESTRATOR_SHARED_SECRET=CHANGEME-generate-with-openssl-rand-base64-32
# MUST match orchestrator-config's WS_GATEWAY_JWT_SECRET.
JWT_SECRET=CHANGEME-generate-with-openssl-rand-base64-32
