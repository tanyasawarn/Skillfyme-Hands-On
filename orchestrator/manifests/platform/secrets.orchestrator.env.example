# Copy to secrets.orchestrator.env (gitignored), fill in, then:
#   kubectl -n practiceengine-platform create secret generic orchestrator-config \
#     --from-env-file=secrets.orchestrator.env --dry-run=client -o yaml | kubectl apply -f -
DATABASE_URL=postgres://practice:CHANGEME@postgres.practiceengine-platform.svc:5432/practice_engine
REDIS_URL=redis://redis.practiceengine-platform.svc:6379
NATS_URL=nats://nats.practiceengine-platform.svc:4222
# 40+ random chars. MUST match practice-core-config's ORCHESTRATOR_SHARED_SECRET.
ORCHESTRATOR_SHARED_SECRET=CHANGEME-generate-with-openssl-rand-base64-32
# MUST match practice-core-config's JWT_SECRET.
WS_GATEWAY_JWT_SECRET=CHANGEME-generate-with-openssl-rand-base64-32
