# Copy to .env and fill in real values for local dev. Loaded automatically
# via godotenv when run from this directory. See practice-core/.env.example
# for the counterpart config the NestJS side needs -- WS_GATEWAY_JWT_SECRET
# below MUST match that file's JWT_SECRET.

# --- K8s ---
KUBECONFIG=../.local/k3s-output/kubeconfig.yaml

# --- Postgres / Redis / NATS ---
DATABASE_URL=postgres://practice:practice@localhost:5433/practice_engine
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# --- gRPC / WS Gateway ---
ORCHESTRATOR_GRPC_PORT=50051
ORCHESTRATOR_WS_PORT=8081
WS_GATEWAY_BASE_URL=ws://localhost:8081
WS_GATEWAY_ALLOWED_ORIGINS=

# Shared-secret signer for terminal session JWTs -- MUST equal
# practice-core/.env's JWT_SECRET. Dev only; rotate and move to a real
# secret store before any non-local deployment.
WS_GATEWAY_JWT_SECRET=change-me-dev-only

# --- Cost / budget ---
DEFAULT_BUDGET_USD=0.08

# --- Warm pool filler ---
# Empty = disabled. Format: "blueprint_id:count,blueprint_id:count".
WARM_POOL_TARGETS=
WARM_POOL_FILL_INTERVAL=20s
