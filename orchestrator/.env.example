# Copy to .env and fill in real values for local dev. Loaded automatically
# via godotenv when run from this directory. See practice-core/.env.example
# for the counterpart config the NestJS side needs -- WS_GATEWAY_JWT_SECRET
# below MUST match that file's JWT_SECRET.

# --- K8s ---
KUBECONFIG=../.local/k3s-output/kubeconfig.yaml

# PLAN.md M1.1/M1.14: T1 workspace pods should run under the gVisor
# RuntimeClass (manifests/t1/runtimeclass-gvisor.yaml). Defaults false --
# hardcoding this on a cluster without gVisor installed makes every
# Provision() call fail scheduling. Set true only after confirming gVisor
# is actually installed on this deployment's T1 node pool.
ORCHESTRATOR_GVISOR_ENABLED=false

# --- Postgres / Redis / NATS ---
DATABASE_URL=postgres://practice:practice@localhost:5433/practice_engine
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# --- gRPC / WS Gateway ---
ORCHESTRATOR_GRPC_PORT=50051
ORCHESTRATOR_WS_PORT=8081
WS_GATEWAY_BASE_URL=ws://localhost:8081
WS_GATEWAY_ALLOWED_ORIGINS=

# --- Observability (doc §11) ---
# Prometheus /metrics + /healthz, on their own port so scraping never
# contends with the gRPC or WS data planes. Set empty to disable.
# All Phase 1 exit criteria (time-to-ready p95, provision success rate,
# cost/attempt, zero-orphan gate) are measured off this endpoint --
# see evaluation/phase1/observability/.
ORCHESTRATOR_METRICS_PORT=9090

# Shared-secret signer for terminal session JWTs -- MUST equal
# practice-core/.env's JWT_SECRET. Dev only; rotate and move to a real
# secret store before any non-local deployment.
#
# PLAN.md K17: this has no fallback in code (internal/config.Config's
# WSGatewayJWTSecret) -- an unset value makes NewTokenValidator panic
# at boot rather than silently signing session JWTs with a shared,
# committed-to-source secret. Required, not optional, even for local dev.
WS_GATEWAY_JWT_SECRET=change-me-dev-only

# Bearer token every gRPC RPC (except the health check) requires in an
# "authorization: Bearer <token>" metadata header -- see
# internal/orchestrator/auth.go. MUST equal practice-core/.env's
# ORCHESTRATOR_SHARED_SECRET. Empty (the default if unset) DISABLES
# authentication entirely -- every RPC becomes reachable by any network
# peer that can dial this port. Fine for isolated local dev; set to a
# real secret (and move to a real secret store) before any deployment
# where the network boundary between practice-core and this service
# isn't fully trusted.
ORCHESTRATOR_SHARED_SECRET=

# mTLS -- PLAN.md Phase 2 closure item ("no mTLS between orchestrator and
# its callers, gRPC is plaintext"). Off by default; once true, a
# cert-loading failure is FATAL at boot, never a silent fallback to
# plaintext. Generate a dev CA + certs with: scripts/gen-certs.sh (repo
# root) -- writes to gitignored certs/. MUST be paired with
# practice-core/.env's ORCHESTRATOR_TLS_CA/_CLIENT_TLS_CERT/_CLIENT_TLS_KEY
# pointing at the same CA, or every RPC will fail the TLS handshake.
ORCHESTRATOR_TLS_ENABLED=false
ORCHESTRATOR_TLS_CERT=
ORCHESTRATOR_TLS_KEY=
ORCHESTRATOR_TLS_CA=

# PLAN.md Phase 2: "Dev A should not start T2 until Phase 1's
# reaper/teardown has been running with zero orphans for a sustained
# period -- a real sequencing dependency, not just advisory." Defaults
# to false; only set true after confirming that track record for this
# specific deployment. See internal/orchestrator/server.go's
# Server.t2Enabled doc comment.
ORCHESTRATOR_T2_ENABLED=false

# --- Session recording (doc §5.4 asciicast-to-S3, PLAN.md M1.5) ---
# Empty = disabled (recordings silently dropped, same as before this
# feature existed). For local dev against docker-compose's minio
# service:
#   RECORDING_S3_BUCKET=practice-recordings
#   S3_ENDPOINT_URL=http://localhost:9000
#   AWS_ACCESS_KEY_ID=practice
#   AWS_SECRET_ACCESS_KEY=practice-dev-only
# (AWS_* vars are read by the standard AWS SDK credential chain, not a
# custom var this app defines -- see config.LoadDefaultConfig in
# cmd/orchestrator/main.go.) For real AWS S3, set RECORDING_S3_BUCKET and
# leave S3_ENDPOINT_URL unset; credentials come from the normal AWS
# chain (IAM role, shared config file, etc).
RECORDING_S3_BUCKET=
S3_ENDPOINT_URL=
RECORDING_FLUSH_INTERVAL=5s

# --- Cost / budget ---
DEFAULT_BUDGET_USD=0.08

# --- Warm pool filler ---
# Empty = disabled. Format: "blueprint_id:count,blueprint_id:count".
WARM_POOL_TARGETS=
WARM_POOL_FILL_INTERVAL=20s
