DATABASE_URL=postgres://practice:practice@localhost:5433/practice_engine
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
PORT=3001
CORS_ORIGIN=http://localhost:3000
ORCHESTRATOR_GRPC_ADDRESS=localhost:50051
USE_FAKE_ORCHESTRATOR=false
# Bearer token sent as "authorization: Bearer <token>" on every gRPC call
# to the Environment Orchestrator -- MUST equal orchestrator/.env's
# ORCHESTRATOR_SHARED_SECRET (see that file's comment and
# orchestrator/internal/orchestrator/auth.go). If the orchestrator has
# auth disabled (its own secret unset), leaving this empty is harmless;
# if the orchestrator has auth enabled and this doesn't match, every
# orchestrator call fails with Unauthenticated.
ORCHESTRATOR_SHARED_SECRET=

# mTLS -- PLAN.md Phase 2 closure item, matches orchestrator/.env's
# ORCHESTRATOR_TLS_ENABLED/_CERT/_KEY/_CA. If ORCHESTRATOR_TLS_CA is
# unset, this client dials the orchestrator with plaintext credentials
# (the original behavior) -- once set, ORCHESTRATOR_CLIENT_TLS_CERT/_KEY
# become required and a missing/unreadable file fails loudly at startup
# rather than silently falling back to plaintext or one-way TLS.
# Generate a dev CA + certs with: scripts/gen-certs.sh (repo root).
ORCHESTRATOR_TLS_CA=
ORCHESTRATOR_CLIENT_TLS_CERT=
ORCHESTRATOR_CLIENT_TLS_KEY=

# Shared-secret signer for learner/admin bearer JWTs (dev only -- rotate
# and move to a real secret store before any non-local deployment). Mint
# a dev token with: npm run mint-dev-token
JWT_SECRET=change-me-dev-only

# Doc §6.5/§7 AI-graded rubrics (ClaudeAiGrader) + Phase 3 defence viva
# (RealVivaModel). If NO provider key is set, AI_GRADER / VIVA_MODEL fall
# back to their Fake* stubs (honest, always-provisional -- see the class
# doc comments) so the pipeline still works end-to-end without a key.
#
# Provider selection (llm-tool-call.port.ts):
#   LLM_PROVIDER=groq      -> Groq (OpenAI-compatible), needs GROQ_API_KEY
#   LLM_PROVIDER=anthropic  -> Anthropic Messages API, needs ANTHROPIC_API_KEY
#   LLM_PROVIDER unset      -> infer from whichever key is present;
#                             ANTHROPIC_API_KEY wins if both are set.
# Groq is intended for free-tier TESTING (rate-limited: requests/min,
# tokens/min, tokens/day -- not a lifetime-unlimited tier); switch to
# Anthropic for production. Neither provider is free per token.
#
# The LLM Gateway (mentor replies, authoring draft(), hint RAG) ALSO
# honours these: with a key present it uses the real provider and the
# FakeLlmProvider is never in the list. Gateway provider ORDER:
#   - LLM_PROVIDER=groq|anthropic wins if set;
#   - else NODE_ENV=production -> Anthropic first, otherwise Groq first;
#   - the other real provider (if its key is set) is kept as failover.
LLM_PROVIDER=

# Groq (https://console.groq.com). Free tier for testing, then pay-as-you-go.
GROQ_API_KEY=
# Gateway + tool-caller default model. Newer Groq keys expose the OpenAI
# gpt-oss pair; older Llama-3.x ids may 404. Defaults to
# openai/gpt-oss-120b (strong/mid) if unset.
GROQ_MODEL=
# Gateway fast-tier model (intent classify / hint RAG / summarise).
# Defaults to openai/gpt-oss-20b if unset.
GROQ_FAST_MODEL=

# Anthropic (production default).
ANTHROPIC_API_KEY=
# Grader model; defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_GRADER_MODEL=
# Viva-question model; defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_VIVA_MODEL=
# Gateway per-tier models; default to claude-haiku-4-5 (fast) and
# claude-sonnet-4-5 (mid/strong).
ANTHROPIC_FAST_MODEL=
ANTHROPIC_MID_MODEL=
ANTHROPIC_STRONG_MODEL=

# Independent samples per grading for the self-consistency check
# (doc §6.5 rule 33). Default 3, clamped [1,5]. Biggest cost lever --
# each sample is a full API call. ANTHROPIC_GRADER_SAMPLE_COUNT still
# honoured for back-compat.
GRADER_SAMPLE_COUNT=
